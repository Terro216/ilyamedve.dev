---
import SEO from "../components/SEO.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html 🦎>
  <head>
    <title>i</title>
    <SEO />
  </head>

  <body>
    <slot />
    <style is:global>
      body {
        margin: 0;
        background: rgb(27, 24, 29);
        font-family: $base-font;
        color: $text-white;
        padding: 0 3%;
      }

      a {
        color: inherit;
      }
    </style>
  </body>
</html>
